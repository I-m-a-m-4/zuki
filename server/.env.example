# Zuki account server — copy to server/.env and fill in.
#
# One-time Firebase console setup
# (console.firebase.google.com/project/zuki-ai):
#   1. Authentication → Get started → Sign-in method → Email/Password → Enable.
#      Without this, every sign-up fails with CONFIGURATION_NOT_FOUND.
#   2. Note the Project ID (below) — accounts live there; this server only
#      verifies their tokens, so no private keys are involved.
#   3. Put your own email in ADMIN_EMAILS so only you can open /admin/.
#
# Run from the repo root:  uvicorn server.main:app --port 8787

# YOUR Claude API key. Lives ONLY here — it never ships in the desktop app.
ANTHROPIC_API_KEY=sk-ant-...

# Firebase project whose accounts are accepted (from the Firebase console).
FIREBASE_PROJECT_ID=zuki-ai

# Admin access for the /admin/ page: your Firebase account email(s).
# Only these accounts can open the management page. Comma-separated.
ADMIN_EMAILS=you@example.com

# Optional script/CLI admin token for /admin/* REST calls.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Per-account daily cap on Claude requests (admin accounts are exempt).
DAILY_REQUEST_LIMIT=200

# Optional: comma-separated model allowlist. Empty = allow every model.
# ALLOWED_MODELS=claude-sonnet-4-5,claude-haiku-4-5

# Leave commented to use the real Anthropic API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# HOST=0.0.0.0
# PORT=8787
# ZUKI_DB_PATH=server/data/zuki.db
