# ============================================================
# Zuki for Windows — API Keys (all optional, auto-detected)
# ============================================================
# Copy this file to .env and fill in the keys you have.
# Zuki auto-detects what's available and uses the best one.
# If no keys are set, it falls back to Ollama (free, local).

# ── Zuki account (the official build) ──────────────────────
# Users sign in / create a free account in the app on first launch; Claude
# requests then go through the Zuki server, which holds the key — no
# ANTHROPIC_API_KEY ships in (or is needed by) the desktop client.
# ZUKI_REQUIRE_ACCOUNT=1                # 0 = local ANTHROPIC_API_KEY may stand alone (dev)
# ZUKI_SERVER_URL=http://127.0.0.1:8787 # point at your Zuki account server
# Self-hosters also override the Firebase project:
# ZUKI_FIREBASE_API_KEY=...
# ZUKI_FIREBASE_AUTH_DOMAIN=...

# ── LLM Providers (priority: Claude > OpenAI > Gemini > Ollama) ──
# ANTHROPIC_API_KEY is for dev / self-host only — with an account signed in,
# the client ignores it and uses the server instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Speech-to-Text ───────────────────────────────────────────
# Leave empty to use faster-whisper (free, local, runs on CPU)
DEEPGRAM_API_KEY=
# OPENAI_API_KEY also enables OpenAI Whisper if set above

# ── Text-to-Speech ───────────────────────────────────────────
# Leave empty to use edge-tts (free, no key, Microsoft neural)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Web Search (for grounding LLM with live info) ────────────
# Leave empty to use DuckDuckGo (free, no key)
TAVILY_API_KEY=

# ── Ollama Settings ──────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# Legacy single-model knob (used as fallback if the two below are empty)
OLLAMA_MODEL=llama3.2-vision
# Per-task model selection — vision = screen-aware, text = Code Mode / journal Q&A.
# Pick any model you've `ollama pull`'d. Tray → Ollama → "Pull recommended"
# downloads curated picks (qwen2-vl, llama3.2-vision, qwen2.5-coder, etc.)
OLLAMA_VISION_MODEL=
OLLAMA_TEXT_MODEL=

# ── App Settings ─────────────────────────────────────────────
# Hotkey to activate push-to-talk (default: ctrl+alt+m)
ZUKI_HOTKEY=ctrl+alt+m
# Whisper model size: tiny, base, small, medium (larger = slower but more accurate)
WHISPER_MODEL=base
