# Zuki configuration — copy to a real `.env` and fill in what you use.
#
# For the VOICE COMPANION (`zuki run`), put this at:  zuki/shell/.env
# For the FILE ORGANIZER  (`zuki organize`), the project root `.env` is fine.
# (A first-run setup wizard can also fill these in for you.)

# ─────────────────────────────────────────────────────────────────────
# VOICE COMPANION (zuki run)  — sign in with a free Zuki account.
# The account server holds the Claude key; no key is needed on this machine.
# For dev / self-host, you can instead point at your own key below.
# ─────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...        # dev only — seeing / pointing / acting
DEEPGRAM_API_KEY=...                  # recommended: fast, accurate speech-to-text
                                      # (without it, falls back to slower local Whisper)
ZUKI_REQUIRE_ACCOUNT=1              # 0 = allow a local ANTHROPIC_API_KEY alone
ZUKI_SERVER_URL=http://127.0.0.1:8787   # the Zuki account server
ZUKI_ACTIVE_LLM=claude              # claude | openai | gemini | ollama
ZUKI_HOTKEY=ctrl+alt+m              # push-to-talk hotkey (hold to talk)

# ─────────────────────────────────────────────────────────────────────
# FILE ORGANIZER (zuki organize)  — pick ONE provider, or use free modes
# ─────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...        # provider: claude  (best quality)
# OPENAI_API_KEY=sk-...               # provider: openai
# GOOGLE_API_KEY=AIza...              # provider: gemini

# --- Local / free (no key needed) ---
# OLLAMA_HOST=http://localhost:11434  # provider: ollama (default if no cloud key)
# ZUKI_OLLAMA_MODEL=llama3.1

# --- Force a provider regardless of keys ---
# ZUKI_PROVIDER=heuristic           # heuristic | ollama | claude | openai | gemini

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL — Gmail / Calendar via the Google API (see zuki/shell/google_workspace.py)
# ─────────────────────────────────────────────────────────────────────
# Not set here — drop a Desktop OAuth client at ~/.zuki/google_credentials.json.
# Without it, Zuki just opens your logged-in Gmail/Calendar in the browser instead.

# --- Background agents (optional) ---
# ZUKI_BG_MODEL=claude-sonnet-5     # model background tasks run on
# ZUKI_BG_TIMEOUT=900               # max seconds per background task
# COMPOSIO_API_KEY=ck_...             # optional: auto-connects 1000+ apps for
#                                     # background agents (or use the wizard's
#                                     # browser sign-in / `zuki connect composio`)
